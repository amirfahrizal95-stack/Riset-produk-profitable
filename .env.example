# WAJIB — kunci Claude API (https://platform.claude.com). Dipakai untuk riset web + analisis.
ANTHROPIC_API_KEY=

# Opsional — model & kedalaman riset
RESEARCH_MODEL=claude-opus-5-5
RESEARCH_EFFORT=high
MAX_WEB_SEARCHES=15
MAX_WEB_FETCHES=8

# Opsional — data langsung dari Etsy Open API v3 (https://www.etsy.com/developers)
# Isi persis seperti nilai header x-api-key yang diminta Etsy (keystring, atau keystring:shared_secret).
ETSY_API_KEY=

# Opsional — data langsung dari Meta Ad Library API (https://www.facebook.com/ads/library/api)
# Catatan: API ini hanya menampilkan iklan komersial yang tayang di Uni Eropa/UK.
META_ACCESS_TOKEN=
META_AD_COUNTRIES=GB,DE,FR

# Opsional — kode akses agar orang lain tidak memakai kuota API Anda saat di-deploy publik
ACCESS_CODE=

PORT=3000
